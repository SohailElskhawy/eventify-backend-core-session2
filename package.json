{
  "name": "eventify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Eventify - the event booking API built across the course",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "dev": "node --watch --env-file=.env src/server.ts",
    "worker": "node --watch --env-file=.env src/worker.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.30.0",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.1"
  }
}
